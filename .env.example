NODE_ENV=production
HOST=0.0.0.0
PORT=4000

CORS_ORIGINS=https://your-domain.com
JWT_SECRET=replace-with-long-random-secret
REFRESH_TOKEN_TTL_DAYS=30
ACCESS_TOKEN_TTL_MINUTES=15

# If password contains special URL characters, URL-encode it in DATABASE_URL.
DATABASE_URL=postgresql://postgres:replace-with-strong-password@db:5432/mind_tracker

POSTGRES_DB=mind_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-password
